# Copy to `.env` to override the lab's settings: `cp .env.example .env`
# `.env` is git-ignored. Never commit it, and never put real passwords or API keys in this file.
#
# Every value below is optional. When unset, compose.yaml uses local-only development
# defaults (user/password/database "projlab") that are fine on your own machine or Codespace.
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# Host ports (change them if already in use on your machine).
# JUPYTER_PORT=8888
# SPARK_UI_PORT=4040
# JupyterLab login token (local-only default: projlab).
# JUPYTER_TOKEN=
# Memory for the Spark driver inside the workspace.
# SPARK_DRIVER_MEMORY=1g
